# À copier en .env.local pour le développement (ignoré par Git). En production, ces
# valeurs viennent de Secret Manager (infra/examinateur.sh).

# Empreinte SHA-256 du code d'accès, sans tirets. Pour le code « dev » :
#   printf dev | openssl dgst -sha256 -r
EXAMINATEUR_CODE_EMPREINTE=
# N'importe quelle chaîne aléatoire : openssl rand -base64 32
EXAMINATEUR_CLE_SESSION=
